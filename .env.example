# ===== Vercel -> Project -> Settings -> Environment Variables ga shularni kiriting =====

# --- Firebase (anonim kirish + baza). Firebase konsol -> Project settings ---
FIREBASE_PROJECT_ID=sizning-loyiha-id
FIREBASE_WEB_API_KEY=AIza...            # Project settings -> General -> Web app -> apiKey
FIREBASE_APP_ID=1:123:web:abc           # Web app -> appId
# Service account (Project settings -> Service accounts -> Generate new private key) — JSON ichidan:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@sizning-loyiha-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# --- Gemini (bepul): https://aistudio.google.com/apikey ---
GEMINI_API_KEYS=AIza...1,AIza...2       # 2 ta kalit vergul bilan (yoki GEMINI_API_KEY + GEMINI_API_KEY_2)

# --- Admin panel ---
ADMIN_USERNAME=admin
# Parol xeshi (tavsiya):  npm run hash -- "sizning-parolingiz"   natijasini shu yerga qo'ying
ADMIN_PASSWORD_HASH=scrypt$16384$...
# yoki oddiy usul (xeshsiz, kamroq xavfsiz): ADMIN_PASSWORD=...
SESSION_SECRET=kamida-32-belgili-tasodifiy-matn
